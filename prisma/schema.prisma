generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                   String   @id @default(uuid()) @db.Uuid
  created_at           DateTime @default(now())
  company_name         String
  role                 String
  location             String
  package              String
  eligibility_criteria String
  description          String
  application_deadline DateTime

  applications Application[]

  @@index([created_at(sort: Desc)])
}

model Application {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())

 status ApplicationStatus @default(APPLIED)
 
  // Job relationship: one job can receive many applications
  job_id String @db.Uuid
  job    Job    @relation(fields: [job_id], references: [id], onDelete: Cascade)

  // Student relationship: one student can submit many applications
  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  name       String
  email      String
  phone      String
  resume_url String

  compatibility_score Int?
  matching_skills     Json?
  missing_skills      Json?

  @@unique([user_id, job_id])
  @@index([job_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // Common fields
  firstName   String?
  middleName  String?
  lastName    String?

  // Student specific fields
  location        String?
  primaryRole     String?
  experienceYears Int?
  openToRoles     String[]
  bio             String?
  website         String?
  linkedin        String?
  github          String?
  twitter         String?
  workExperience  Json?
  education       Json?
  skills          String[]
  achievements    String?
  pronouns        String?
  genderIdentity  String?
  resumeUrl       String?

  // TPC specific fields
  designation String?

  // Company specific fields
  companyName     String?
  companyLocation String?

  //job Applications submitted by this student
  applications Application[]
  //internship Applications submitted by this student
  internshipApplications InternshipApplication[]
}

enum Role {
  STUDENT
  COMPANY
  TPC
}
enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
}
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}


enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Internship {
  id                   String   @id @default(uuid()) @db.Uuid
  created_at           DateTime @default(now())

  company_name         String
  role                 String
  location             String
  work_mode            WorkMode
  stipend              String
  duration             String

  eligibility_criteria String
  required_skills      String[]
  description          String

  application_deadline DateTime
  start_date           DateTime?

  applications InternshipApplication[]

  @@index([created_at(sort: Desc)])
}

model InternshipApplication {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now())

  status ApplicationStatus @default(APPLIED)

  internship_id String     @db.Uuid
  internship    Internship @relation(fields: [internship_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  name       String
  email      String
  phone      String
  resume_url String

  @@unique([user_id, internship_id])
  @@index([internship_id, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
}
